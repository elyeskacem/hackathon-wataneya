# Copy to .env.local to change behaviour. Never put API keys here: everything VITE_* ships to the browser.

# Show the 3D figure of Om Kalthoum on the concert stage (off by default, see docs/PLAN.md §6.6).
VITE_SHOW_OM_KALTHOUM_FIGURE=false
# Show years that are not yet verified against the Wataniya archive (off by default).
VITE_SHOW_UNVERIFIED_YEARS=false
# Optional server endpoint for a real LLM guide. The server holds the keys and answers from the archive only.
VITE_GUIDE_ENDPOINT=
